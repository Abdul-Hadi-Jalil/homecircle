APP_ENV=development
APP_NAME=HomeCircle API
# Use the restricted homecircle_api login created by migrations, never postgres.
# Direct or session pooler (5432); URL-encode the password.
DATABASE_URL=
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=certs/supabase-root-2021.pem
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
DATABASE_POOL_TIMEOUT=10
DATABASE_CONNECT_TIMEOUT=10
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Defaults to SUPABASE_URL/auth/v1 when blank.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# jwks supports ES256 and RS256; legacy_hs256 requires the server-only secret below.
SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=[]
# Generate at least 32 random characters; keep stable across API replicas.
INVITATION_PEPPER=
INVITATION_EXPIRY_DAYS=7
INVITATION_MAX_USES=10
# Chat limits per user/household/minute; decoded image limit is at most 5 MiB.
CHAT_IMAGE_MAX_BYTES=5242880
CHAT_MESSAGE_RATE=60
CHAT_REACTION_RATE=120
CHAT_UPLOAD_RATE=10
